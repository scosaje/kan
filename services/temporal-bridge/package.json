{
  "name": "@kan/temporal-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridges Kan webhook events to Temporal workflows. Per-card opt-in via a WORKFLOW label. Policies are matched by board shape so it works for any board with the same lane convention.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.1",
    "@temporalio/client": "^1.11.1",
    "@temporalio/worker": "^1.11.1",
    "@temporalio/workflow": "^1.11.1",
    "express": "^4.21.0",
    "pg": "^8.11.3",
    "pino": "^9.5.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.7",
    "@types/pg": "^8.10.9",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
